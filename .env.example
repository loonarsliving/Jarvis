# AI Asset Factory — environment variables.
# Binding list: docs/ai-asset-factory/tdd/07-config-storage-performance-scalability.md §30
# Validated at process startup by packages/core/src/config (loadConfig()) —
# a service fails fast with a clear error if a required variable is missing.
#
# Copy to .env and fill in real values. .env is gitignored; never commit secrets.

# --- Core (all services) -----------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# --- Database (all services) — Postgres via Supavisor pooler, TDD §7.6 -------
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- Supabase (web) -----------------------------------------------------------
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=replace-with-anon-key
# RLS-bypassing service access — all workers + web server-side admin actions.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Browser-bundled duplicates of SUPABASE_URL/SUPABASE_ANON_KEY above — Next.js
# only inlines env vars prefixed NEXT_PUBLIC_ into the client bundle (TDD §30
# doesn't enumerate these separately since they carry the same values; kept
# out of packages/core/config's Zod schema, which validates server-only config).
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# --- Higgsfield (mission-dispatcher, higgsfield-poller) — Agent 4 scope -----
HIGGSFIELD_API_KEY=replace-with-higgsfield-api-key
HIGGSFIELD_API_BASE_URL=https://api.higgsfield.ai
HIGGSFIELD_TIMEOUT_MS=600000
HIGGSFIELD_TRAINING_TIMEOUT_MS=2700000

# --- Google Drive (drive-sync-worker, web DNA turnaround preview) — Agent 5 -
# Service account JSON, single-line. Prefer mounting as a Docker secret/file
# in production (TDD §26.2) — this env var is the local-dev convenience path.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_DRIVE_ROOT_FOLDER_ID=replace-with-shared-drive-root-folder-id

# --- Retry policy (all workers, TDD §25) --------------------------------------
RETRY_MAX_ATTEMPTS=4
RETRY_BACKOFF_BASE_MS=20000

# --- Worker identity -----------------------------------------------------------
# Typically set to the container hostname at runtime; only needed for local
# single-instance dev if you want a stable claimed_by value.
WORKER_INSTANCE_ID=local-dev

# --- Notifications (web) — Agent 7 scope ----------------------------------------
NOTIFICATION_EMAIL_PROVIDER_HOST=smtp.example.com
NOTIFICATION_EMAIL_PROVIDER_PORT=587
NOTIFICATION_EMAIL_PROVIDER_USER=replace-with-smtp-user
NOTIFICATION_EMAIL_PROVIDER_PASSWORD=replace-with-smtp-password
NOTIFICATION_EMAIL_PROVIDER_FROM=noreply@example.com

# Optional — mirrors MK Connect's WhatsApp bridge integration, FSD §21.
WHATSAPP_BRIDGE_URL=
WHATSAPP_BRIDGE_TOKEN=

# --- Docker Compose / self-hosted Supabase stack only -------------------------
# NOT part of packages/core/config's schema (§30/§31 cover application config;
# these are infra/docker-compose.yml-only secrets consumed directly by the
# Supabase containers themselves, never read by @aaf/core or any app/worker
# process — see infra/supabase/docker-compose.supabase.yml and DECISIONS.md).
AAF_DOMAIN=localhost
POSTGRES_PASSWORD=replace-with-strong-password
SUPABASE_JWT_SECRET=replace-with-at-least-32-char-secret
SUPAVISOR_SECRET_KEY_BASE=replace-with-generated-secret
SUPAVISOR_VAULT_ENC_KEY=replace-with-generated-secret
